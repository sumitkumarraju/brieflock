{
  "name": "brieflock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:contract": "source $HOME/.cargo/env 2>/dev/null || true; cargo test --manifest-path contracts/brieflock/Cargo.toml --lib",
    "test:sandbox": "source $HOME/.cargo/env 2>/dev/null || true; cargo build --manifest-path contracts/brieflock/Cargo.toml --target wasm32-unknown-unknown --release && cargo test --manifest-path contracts/brieflock/Cargo.toml --test sandbox",
    "build:contract": "source $HOME/.cargo/env 2>/dev/null || true; cargo build --manifest-path contracts/brieflock/Cargo.toml --target wasm32-unknown-unknown --release",
    "demo:attacks": "vite-node scripts/demo-attacks.ts"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "lucide-react": "^0.468.0",
    "near-api-js": "^7.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^2.1.0"
  }
}
